RKNODE_PLATFORM_URL=http://192.168.1.10:5173
RKNODE_ENDPOINT_ID=replace-with-platform-endpoint-id
RKNODE_ENROLLMENT_TOKEN_PATH=./secrets/trainer-enrollment-token
RKNODE_NODE_NAME=cpu-trainer-01
RKNODE_NODE_HOST_PORT=10081
RKNODE_NODE_ACCELERATOR=cpu
RKNODE_NODE_CAPABILITIES=yolo-detect,deeplabv3plus
RKNODE_NODE_MAX_CONCURRENCY=1

# CPU Torch defaults. For CUDA set the matching fixed CUDA image,
# RKNODE_NODE_ACCELERATOR=cuda, then start with:
# docker compose -f compose.yaml -f compose.cuda.yaml up -d --no-build
RKNODE_TRAINER_DOCKERFILE=deploy/Dockerfile.trainer-torch
RKNODE_TRAINER_BASE_IMAGE=python:3.11-slim
RKNODE_TRAINER_IMAGE=rknode-trainer-torch-cpu:2026.08.20
RKNODE_PYTHON_INDEX_URL=https://pypi.org/simple
RKNODE_DEBIAN_MIRROR=http://deb.debian.org
RKNODE_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RKNODE_TORCH_VERSION=2.5.1+cpu
RKNODE_TORCHVISION_VERSION=0.20.1+cpu
RKNODE_CUDA_DEVICE_COUNT=1
RKNODE_CONTAINER_LOG_MAX_SIZE=20m
RKNODE_CONTAINER_LOG_MAX_FILES=3

# Central Compose only exposes the web gateway. Workers reach the API through it.
# LEGACY PULL WORKER/AGENT EXAMPLE. New RK3588 nodes use deploy/nodes/rk3588
# with compose.enrollment.yaml and separate converter/inference endpoint IDs.
RKNODE_API_URL=http://CENTRAL_SERVER_IP:5173
RKNODE_RK3588_IMAGE=rknode-rk3588-node:2026.08.20-business
RKNODE_WORKER_TOKEN=the-same-worker-token-as-central-api
RKNODE_WORKER_NAME=rk3588-converter-01
RKNODE_WORKSPACE_RECONCILE_SECONDS=30

# Create this board in the console first. The registration token is one-time use.
RKNODE_NODE_ID=inode_replace_me
RKNODE_REGISTRATION_TOKEN=replace_with_one_time_registration_token
RKNODE_HARDWARE_ID=rk3588-board-01
RKNODE_RUNTIME_VERSION=rknn-runtime-2.3.2
RKNODE_DRIVER_VERSION=unknown
RKNODE_PIPELINE_VERSION=rknode-cpp-runtime-2026.08.20-business
RKNODE_CONVERTER_BASE_IMAGE=rknn_toolkit2:2.3.2-debian12-cp311-aarch64
RKNODE_INFERENCE_BASE_IMAGE=debian:bookworm
RKNODE_DEBIAN_MIRROR=http://deb.debian.org
RKNODE_PYTHON_INDEX_URL=https://pypi.org/simple
# Only advertise adapters actually compiled into the local inference runtime.
RKNODE_ADAPTERS=yolo_dfl_split_v1,deeplab_logits_v1,ppocr_db_det_v1,ppocr_ctc_rec_v1
RKNODE_MEDIA_FEATURES=rkmpp_decode,bytetrack,kafka,zlm_sei,analytics_area,analytics_line,event_snapshot,event_record,secondary_infer
RKNODE_POLL_SECONDS=3
# Production defaults to fail closed. These commands must return 0 only after
# the corresponding board/runtime operation actually succeeds.
RKNODE_STAGING_ONLY=false
RKNODE_SELF_TEST_COMMAND=/opt/rknode/runtime-adapter/self-test.sh
RKNODE_MODEL_PROBE_COMMAND=/opt/rknode/runtime-adapter/probe-model.sh
RKNODE_RUNTIME_COMMAND=/opt/rknode/runtime-adapter/activate-task.sh
RKNODE_RUNTIME_HEALTH_COMMAND=/opt/rknode/runtime-adapter/health.sh
RKNODE_RUNTIME_TIMEOUT_SECONDS=120
RKNODE_INFERENCE_OUTPUT_DIR=./output
RKNODE_REQUIRE_NPU_DEVICE=true
RKNODE_AUTO_RECOVER=true
RKNODE_RESULT_SINK_TOKEN=

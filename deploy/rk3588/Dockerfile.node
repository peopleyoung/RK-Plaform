ARG RKNN_TOOLKIT_IMAGE=rknn_toolkit2:2.3.2-debian12-cp311-aarch64
FROM ${RKNN_TOOLKIT_IMAGE} AS rknode-root

ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 PYTHONPATH=/opt/rknode
ARG DEBIAN_MIRROR=http://deb.debian.org
ARG PYTHON_INDEX_URL=https://pypi.org/simple
RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
      -exec sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" {} + \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential cmake pkg-config ca-certificates \
       libopencv-core-dev libopencv-imgproc-dev libopencv-imgcodecs-dev \
       libopencv-videoio-dev libyaml-cpp-dev libspdlog-dev libjsoncpp-dev \
       libcurl4-openssl-dev libeigen3-dev \
       libavformat-dev libavcodec-dev libavutil-dev librdkafka-dev \
       libdrm-dev libgomp1 \
    && python3 -m pip install --break-system-packages --no-cache-dir \
       --timeout 120 --retries 10 --index-url "${PYTHON_INDEX_URL}" \
       fastapi==0.141.1 uvicorn==0.52.0

COPY third_party/nv_video_pipeline /opt/rknode/src/nv_video_pipeline
RUN cmake -S /opt/rknode/src/nv_video_pipeline -B /tmp/rknode-build \
        -DRKNN_SDK_ROOT=/opt/rknode/src/nv_video_pipeline/3rdparty/rknpu2 \
        -DROCKCHIP_MPP_ROOT=/opt/rknode/src/nv_video_pipeline/3rdparty/rockchip-mpp \
        -DRKNODE_WITH_RKMPP=ON \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/rknode-build --parallel 2 \
    && install -m 0755 \
       /tmp/rknode-build/bin/rknn_pipeline \
       /tmp/rknode-build/bin/rknn_smoke \
       /tmp/rknode-build/bin/rknn_instance_probe \
       /tmp/rknode-build/bin/rknn_protocol_probe /usr/local/bin/ \
    && install -m 0755 /tmp/rknode-build/bin/libVideoPipeline_RKNN.so /usr/local/lib/ \
    && ln -sfn /opt/rknode/src/nv_video_pipeline/3rdparty/rknpu2 /opt/rknn-sdk \
    && ln -sfn /opt/rknode/src/nv_video_pipeline/3rdparty/rockchip-mpp /opt/rockchip-mpp \
    && ln -sfn /opt/rknn-sdk/Linux/aarch64/librknnrt.so /usr/local/lib/librknnrt.so \
    && ln -sfn /opt/rockchip-mpp/lib/librockchip_mpp.so.1 \
       /usr/local/lib/librockchip_mpp.so.1 \
    && ln -sfn /usr/local/lib/librockchip_mpp.so.1 /usr/local/lib/librockchip_mpp.so \
    && ldconfig \
    && rm -rf /tmp/rknode-build

COPY backend /opt/rknode/backend
COPY workers /opt/rknode/workers
COPY config /opt/rknode/config
COPY deploy/rk3588/runtime-adapter /opt/rknode/runtime-adapter
RUN chmod 0755 /opt/rknode/runtime-adapter/*.sh \
    && mkdir -p /data/jobs /data/models /data/state /data/runtime /data/output \
    && site=/usr/local/lib/python3.11/dist-packages \
    && rm -rf \
       "${site}"/tensorflow "${site}"/tensorflow-* "${site}"/tensorflow_* \
       "${site}"/keras "${site}"/keras-* "${site}"/keras_* \
       "${site}"/tensorboard "${site}"/tensorboard-* "${site}"/tensorboard_* \
       "${site}"/h5py "${site}"/h5py-* "${site}"/h5py.* \
       "${site}"/clang "${site}"/clang-* \
       "${site}"/torch/include "${site}"/torch/test \
       /rknn_toolkit2-*.whl /root/.cache /tmp/* /var/tmp/* \
       /var/lib/apt/lists/* /var/cache/apt/* \
       /usr/share/doc/* /usr/share/man/* /usr/share/info/* \
    && find "${site}" /opt/rknode -type d -name __pycache__ \
       -prune -exec rm -rf '{}' + \
    && python3 -c "from rknn.api import RKNN; import onnx; print('RKNN ONNX runtime ready')"

# This target is complete and deployable without flattening the Toolkit base.
# It is intended for native RK3588 builds on boards with limited Docker storage.
FROM rknode-root AS rknode-runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/rknode
WORKDIR /opt/rknode

ARG RKNODE_RELEASE_VERSION=dev
ARG RKNODE_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="RKNode RK3588 Node" \
      org.opencontainers.image.version="${RKNODE_RELEASE_VERSION}" \
      org.opencontainers.image.revision="${RKNODE_SOURCE_REVISION}" \
      io.rknode.component="rk3588-node" \
      io.rknode.roles="converter,inference" \
      io.rknode.accelerator="rk3588" \
      io.rknode.runtime="cpp-rknn" \
      io.rknode.inference-business="analytics,bytetrack,secondary-yolo,event-media,kafka,zlm-sei" \
      io.rknode.inference-concurrency="context-pool,worker-pool" \
      io.rknode.face-capabilities="none" \
      io.rknode.build-environment="included" \
      io.rknode.offline-ready="true"

EXPOSE 10081
ENTRYPOINT []
CMD ["python3", "-m", "workers.node_service.main"]

# Flatten the prepared root filesystem so files removed from the 4.3 GB
# upstream Toolkit image do not remain reachable through parent image layers.
FROM scratch AS rknode-flat
COPY --from=rknode-runtime / /

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/rknode
WORKDIR /opt/rknode

ARG RKNODE_RELEASE_VERSION=dev
ARG RKNODE_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="RKNode RK3588 Node" \
      org.opencontainers.image.version="${RKNODE_RELEASE_VERSION}" \
      org.opencontainers.image.revision="${RKNODE_SOURCE_REVISION}" \
      io.rknode.component="rk3588-node" \
      io.rknode.roles="converter,inference" \
      io.rknode.accelerator="rk3588" \
      io.rknode.runtime="cpp-rknn" \
      io.rknode.inference-business="analytics,bytetrack,secondary-yolo,event-media,kafka,zlm-sei" \
      io.rknode.inference-concurrency="context-pool,worker-pool" \
      io.rknode.face-capabilities="none" \
      io.rknode.build-environment="included" \
      io.rknode.offline-ready="true"

EXPOSE 10081
ENTRYPOINT []
CMD ["python3", "-m", "workers.node_service.main"]

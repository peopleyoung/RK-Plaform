# LEGACY STATIC-TOKEN WORKER EXAMPLE. New nodes use deploy/nodes/trainer with
# compose.enrollment.yaml and a platform-issued endpoint ID.
# Central Compose only exposes the web gateway. Workers reach the API through it.
RKNODE_API_URL=http://CENTRAL_SERVER_IP:5173
RKNODE_WORKER_TOKEN=the-same-worker-token-as-central-api
RKNODE_TORCH_WORKER_NAME=torch-trainer-01
RKNODE_PADDLE_WORKER_NAME=paddle-trainer-01
RKNODE_TORCH_TRAINER_IMAGE=rknode-trainer-torch-cpu:2026.08.20
RKNODE_PADDLE_TRAINER_IMAGE=rknode-trainer-paddle-cpu:2026.08.20
RKNODE_TORCH_CUDA_IMAGE=rknode-trainer-torch-cuda12.4:2026.08.20
RKNODE_PADDLE_CUDA_IMAGE=rknode-trainer-paddle-cuda12.6:2026.08.20
RKNODE_TORCH_ACCELERATOR=cpu
RKNODE_PADDLE_ACCELERATOR=cpu
RKNODE_WORKSPACE_RECONCILE_SECONDS=30
# RKNODE_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# RKNODE_PYTHON_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# RKNODE_CUDA_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
# RKNODE_PADDLE_CUDA_BASE_IMAGE=python:3.11-slim-bookworm
# RKNODE_PADDLE_INDEX_URL=https://www.paddlepaddle.org.cn/packages/stable/cu126/

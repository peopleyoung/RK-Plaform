RKNODE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Legacy pull-Worker compatibility only; register-first direct nodes do not receive this value.
RKNODE_WORKER_TOKEN=replace-with-a-different-long-random-worker-token
RKNODE_API_IMAGE=rknode-platform-api:2026.08.20
RKNODE_WEB_IMAGE=rknode-platform-web:2026.08.20
RKNODE_MEDIA_IMAGE=rknode-platform-media:2026.08.20
RKNODE_ZLM_BASE_IMAGE=SET_FROM_deploy/media/zlm-base-image.lock
RKNODE_WEB_PORT=5173
RKNODE_CORS_ORIGINS=http://CENTRAL_SERVER_IP:5173
RKNODE_PUBLIC_API_URL=http://CENTRAL_SERVER_IP:5173/api/v1
RKNODE_MEDIA_BUILTIN_ENABLED=true
RKNODE_MEDIA_PUBLISH_HOST=CENTRAL_SERVER_IP
RKNODE_MEDIA_PLAYBACK_HOST=CENTRAL_SERVER_IP
RKNODE_MEDIA_RTSP_PORT=8554
RKNODE_MEDIA_WS_PORT=8081
# Run: python scripts/configure_media_secrets.py --env-file deploy/.env
RKNODE_CONTAINER_LOG_MAX_SIZE=20m
RKNODE_CONTAINER_LOG_MAX_FILES=3

    "test:media-e2e": ".venv/bin/python scripts/run_media_e2e.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "mpegts.js": "1.8.2",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest",
    "vitest": "4.1.11"
  }
}
